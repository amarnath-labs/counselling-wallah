/*
|--------------------------------------------------------------------------
| ASPECT TAG
|--------------------------------------------------------------------------
*/

function AspectTag({
  aspect,
  tone = 'normal',
}) {
  const palette = {
    positive: {
      background:
        '#ECFDF3',
      border:
        '#BBF7D0',
      color:
        '#166534',
    },

    negative: {
      background:
        '#FFF1F2',
      border:
        '#FECDD3',
      color:
        '#9F1239',
    },

    missing: {
      background:
        '#F8FAFC',
      border:
        '#E2E8F0',
      color:
        '#64748B',
    },

    normal: {
      background:
        '#F3F4F6',
      border:
        '#E5E7EB',
      color:
        '#374151',
    },
  };

  const style =
    palette[tone] ||
    palette.normal;

  return (
    <span
      style={{
        display:
          'inline-flex',

        alignItems:
          'center',

        padding:
          '5px 9px',

        borderRadius:
          999,

        border:
          `1px solid ${style.border}`,

        background:
          style.background,

        color:
          style.color,

        fontSize:
          11,

        fontWeight:
          700,
      }}
    >
      {humanizeAspect(
        aspect
      )}
    </span>
  );
}


