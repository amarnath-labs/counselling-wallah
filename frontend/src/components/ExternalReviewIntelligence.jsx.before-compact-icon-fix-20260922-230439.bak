      </div>


      {/* =====================================================
          EXPAND BUTTON
      ====================================================== */}

      <button
        type="button"
        className="sei-expand-button"
        onClick={
          () =>
            setExpanded(
              value =>
                !value
            )
        }
      >
        {expanded
          ? 'Hide full Reality Check'
          : 'View full Reality Check'}

        <span>
          {expanded
            ? 'Ã¢â€ â€˜'
            : 'Ã¢â€ â€™'}
        </span>
      </button>


      {/* =====================================================
          FULL INTELLIGENCE
      ====================================================== */}

      {expanded ? (
