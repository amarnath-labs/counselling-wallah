                      item={
                        item
                      }
                      type="negative"
                    />
                  )
                )}
              </div>
            </div>
          ) : null}


          {/* ===============================================
              REALITY CHECK
          ================================================ */}

          <div
            className="sei-reality"
          >
            <div
              className="sei-kicker"
            >
              TRUMARG REALITY CHECK
            </div>


            <h4>
              What students report
            </h4>

            <p>
              Available student feedback
