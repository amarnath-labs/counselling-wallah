{
  "headers": [
    {
      "source": "/colleges-catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://counsellingwallah-backend.onrender.com/api/:path*"
    },
    {
      "source": "/college-predictor",
      "destination": "/college-predictor/index.html"
    },
    {
      "source": "/jee-main-college-predictor",
      "destination": "/jee-main-college-predictor/index.html"
    },
    {
      "source": "/uptac-college-predictor",
      "destination": "/uptac-college-predictor/index.html"
    },
    {
      "source": "/uptac-cutoff-2025",
      "destination": "/uptac-cutoff-2025/index.html"
    },
    {
      "source": "/college-counselling",
      "destination": "/college-counselling/index.html"
    },
    {
      "source": "/career-guidance",
      "destination": "/career-guidance/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "counselling-wallah-frontend.vercel.app"
        }
      ],
      "destination": "https://www.trumarg.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "trumarg.com"
        }
      ],
      "destination": "https://www.trumarg.com/:path*",
      "statusCode": 301
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
