import fs from 'node:fs';
import path from 'node:path';
import {
  fileURLToPath,
} from 'node:url';


const __filename =
  fileURLToPath(
    import.meta.url
  );

const __dirname =
  path.dirname(
    __filename
  );


/*
|--------------------------------------------------------------------------
| PROJECT PATHS
|--------------------------------------------------------------------------
*/

const PROJECT_ROOT =
  path.resolve(
    __dirname,
    '..',
    '..',
    '..'
  );


const JSON_ROOT =
  path.join(
    PROJECT_ROOT,
    'json'
  );


const IIIT_ROOT =
  path.join(
    JSON_ROOT,
    'IIIIT'
  );


/*
|--------------------------------------------------------------------------
| CACHE
|--------------------------------------------------------------------------
*/

let loaded =
  false;


const intelligenceByInstitution =
  new Map();


/*
|--------------------------------------------------------------------------
| NORMALIZATION
|--------------------------------------------------------------------------
*/

function normalize(value) {
  return String(
    value ?? ''
  )
    .toLowerCase()
    .normalize(
      'NFKD'
    )
    .replace(
      /[\u0300-\u036f]/g,
      ''
    )

    /*
    |--------------------------------------------------------------
    | Institute-family normalization
    |--------------------------------------------------------------
    */

    .replace(
      /\bindian institute of information technology\b/g,
      ' iiit '
    )

    .replace(
      /\bnational institute of technology\b/g,
      ' nit '
    )

    .replace(
      /\binternational campus\b/g,
      ' international campus '
    )

    .replace(
      /\bdr[.]?\b/g,
      ' '
    )

    .replace(
      /[^a-z0-9]+/g,
      ' '
    )

    .replace(
      /\s+/g,
      ' '
    )

    .trim();
}


function compact(value) {
  return normalize(
    value
  ).replace(
    /\s+/g,
    ''
  );
}


/*
|--------------------------------------------------------------------------
| SAFE NUMBER
|--------------------------------------------------------------------------
*/

function numberOrNull(
  value
) {
  const number =
    Number(
      value
    );


  return Number.isFinite(
    number
  )
    ? number
    : null;
}


/*
|--------------------------------------------------------------------------
| EVIDENCE LEVEL
|--------------------------------------------------------------------------
*/

function getEvidenceLevel({
  sampleSize,
  sourceCount,
}) {
  const n =
    Number(
      sampleSize
    ) || 0;


  const sources =
    Number(
      sourceCount
    ) || 0;


  let level;


  if (
    n <= 9
  ) {
    level =
      'Insufficient';
  }

  else if (
    n <= 24
  ) {
    level =
      'Very Limited';
  }

  else if (
    n <= 49
  ) {
    level =
      'Limited';
  }

  else if (
    n <= 99
  ) {
    level =
      'Moderate';
  }

  else if (
    n <= 249
  ) {
    level =
      'Strong';
  }

  else {
    level =
      'Very Strong';
  }


  /*
  |--------------------------------------------------------------------------
  | Moderate+ requires source diversity
  |--------------------------------------------------------------------------
  */

  if (
    sources < 3 &&
    [
      'Moderate',
      'Strong',
      'Very Strong',
    ].includes(
      level
    )
  ) {
    return 'Limited';
  }


  return level;
}


/*
|--------------------------------------------------------------------------
| SOURCES
|--------------------------------------------------------------------------
*/

function parseSources(
  dataSource
) {
  if (
    !dataSource
  ) {
    return [];
  }


  return String(
    dataSource
  )
    .split(
      /,|\band\b/gi
    )

    .map(
      item =>
        item
          .replace(
            /\(.*?\)/g,
            ''
          )
          .trim()
    )

    .filter(
      Boolean
    );
}


/*
|--------------------------------------------------------------------------
| BUILD USER-FACING PROFILE
|--------------------------------------------------------------------------
*/

function buildProfile(
  raw
) {
  if (
    !raw ||
    typeof raw !==
      'object'
  ) {
    return null;
  }


  const sources =
    parseSources(
      raw.data_source
    );


  const sampleSize =
    Number(
      raw.sample_size
    ) || 0;


  const evidenceLevel =
    getEvidenceLevel({
      sampleSize,

      sourceCount:
        sources.length,
    });


  const ratings =
    raw.category_ratings ||
    {};


  const sentiment =
    raw.overall_sentiment ||
    {};


  const breakdown =
    raw.sentiment_breakdown ||
    {};


  return {
    version:
      'json-review-v1',


    institution:
      raw.institution ??
      null,


    analysisDate:
      raw.analysis_date ??
      null,


    studentSentiment: {
      label:
        sentiment.label ??
        null,


      score:
        numberOrNull(
          sentiment.score
        ),


      /*
      |--------------------------------------------------------------
      | < 50 stays limited confidence
      |--------------------------------------------------------------
      */

      confidence:
        sampleSize < 50
          ? 'Limited'
          : (
              sentiment.confidence ??
              null
            ),
    },


    evidence: {
      usableEvidence:
        sampleSize,


      threshold:
        50,


      sourceCount:
        sources.length,


      sources,


      level:
        evidenceLevel,


      rankingEligible:
        (
          sampleSize >= 50 &&
          sources.length >= 3
        ),
    },


    ratings: {
      infrastructure:
        numberOrNull(
          ratings
            .college_infrastructure
        ),


      academicsFaculty:
        numberOrNull(
          ratings
            .academics_faculty
        ),


      placements:
        numberOrNull(
          ratings
            .placements
        ),


      valueForMoney:
        numberOrNull(
          ratings
            .value_for_money
        ),


      campusLife:
        numberOrNull(
          ratings
            .campus_life
        ),
    },


    sentimentBreakdown: {
      positive:
        numberOrNull(
          breakdown
            .positive_percent
        ),


      neutral:
        numberOrNull(
          breakdown
            .neutral_percent
        ),


      negative:
        numberOrNull(
          breakdown
            .negative_percent
        ),
    },


    positiveThemes:
      Array.isArray(
        raw.key_positive_themes
      )
        ? raw.key_positive_themes
        : [],


    negativeThemes:
      Array.isArray(
        raw.key_negative_themes
      )
        ? raw.key_negative_themes
        : [],


    distinctionNote:
      raw
        .important_distinction_note ??
      null,


    conclusion:
      raw.conclusion ??
      null,


    disclaimer:
      raw.disclaimer ??
      null,


    /*
    |--------------------------------------------------------------------------
    | Informational rating only
    |--------------------------------------------------------------------------
    */

    reportedOverallRating:
      numberOrNull(
        sentiment
          .overall_rating_out_of_5
      ),


    /*
    |--------------------------------------------------------------------------
    | External JSON remains display-only for now
    |--------------------------------------------------------------------------
    */

    rankingImpact: {
      enabled:
        false,


      reason:
        (
          sampleSize >= 50 &&
          sources.length >= 3
        )
          ? 'Eligible for future V2.1 scoring after validation.'
          : 'Below TruMarg 50-usable-evidence threshold.',
    },
  };
}


/*
|--------------------------------------------------------------------------
| ALIAS REGISTRATION
|--------------------------------------------------------------------------
*/

function registerProfile(
  profile
) {
  if (
    !profile?.institution
  ) {
    return;
  }


  const names =
    new Set([
      profile.institution,

      normalize(
        profile.institution
      ),

      compact(
        profile.institution
      ),
    ]);


  const normalized =
    normalize(
      profile.institution
    );


  /*
  |--------------------------------------------------------------------------
  | IIIT Vadodara ICD explicit aliases
  |--------------------------------------------------------------------------
  */

  if (
    normalized.includes(
      'vadodara'
    ) &&
    (
      normalized.includes(
        'diu'
      ) ||
      normalized.includes(
        'international campus'
      )
    )
  ) {
    [
      'IIITV-ICD',

      'IIITV ICD',

      'IIIT Vadodara International Campus Diu',

      'Indian Institute of Information Technology Vadodara International Campus Diu',

      'Indian Institute of Information Technology Vadodara - International Campus Diu',
    ]
      .forEach(
        alias => {

          names.add(
            alias
          );

          names.add(
            normalize(
              alias
            )
          );

          names.add(
            compact(
              alias
            )
          );
        }
      );
  }


  /*
  |--------------------------------------------------------------------------
  | Register
  |--------------------------------------------------------------------------
  */

  for (
    const name of names
  ) {
    const key =
      compact(
        name
      );


    if (
      !key
    ) {
      continue;
    }


    intelligenceByInstitution
      .set(
        key,
        profile
      );
  }
}


/*
|--------------------------------------------------------------------------
| LOAD JSON FILE
|--------------------------------------------------------------------------
*/

function loadJsonFile(
  filePath
) {
  try {

    const text =
      fs.readFileSync(
        filePath,
        'utf8'
      );


    const parsed =
      JSON.parse(
        text
      );


    const rows =
      Array.isArray(
        parsed
      )
        ? parsed
        : [parsed];


    for (
      const raw of rows
    ) {
      const profile =
        buildProfile(
          raw
        );


      if (
        profile
      ) {
        registerProfile(
          profile
        );
      }
    }
  }

  catch (
    error
  ) {
    console.error(
      '[EXTERNAL REVIEW JSON]',
      filePath,
      error.message
    );
  }
}


/*
|--------------------------------------------------------------------------
| DIRECTORY WALKER
|--------------------------------------------------------------------------
*/

function walkJsonFiles(
  directory,
  {
    recursive = true,
  } = {}
) {
  if (
    !fs.existsSync(
      directory
    )
  ) {
    return;
  }


  const entries =
    fs.readdirSync(
      directory,
      {
        withFileTypes:
          true,
      }
    );


  for (
    const entry of entries
  ) {

    const fullPath =
      path.join(
        directory,
        entry.name
      );


    if (
      entry.isDirectory()
    ) {
      if (
        recursive
      ) {
        walkJsonFiles(
          fullPath,
          {
            recursive,
          }
        );
      }


      continue;
    }


    if (
      entry.isFile() &&
      entry.name
        .toLowerCase()
        .endsWith(
          '.json'
        )
    ) {
      loadJsonFile(
        fullPath
      );
    }
  }
}


/*
|--------------------------------------------------------------------------
| LOAD NIT + IIIT DATA
|--------------------------------------------------------------------------
*/

export function loadExternalReviewJson() {
  if (
    loaded
  ) {
    return;
  }


  loaded =
    true;


  /*
  |--------------------------------------------------------------------------
  | IIIT JSON
  | project/json/IIIIT
  |--------------------------------------------------------------------------
  */

  walkJsonFiles(
    IIIT_ROOT,
    {
      recursive:
        true,
    }
  );


  /*
  |--------------------------------------------------------------------------
  | NIT JSON
  | project/json
  |
  | Non-recursive deliberately prevents loading IIIIT again.
  |--------------------------------------------------------------------------
  */

  walkJsonFiles(
    JSON_ROOT,
    {
      recursive:
        false,
    }
  );


  console.log(
    `[EXTERNAL REVIEW JSON] loaded ${intelligenceByInstitution.size} aliases`
  );
}


/*
|--------------------------------------------------------------------------
| GENERIC MATCHING HELPERS
|--------------------------------------------------------------------------
*/

function institutionTokens(
  value
) {
  const STOP =
    new Set([
      'the',
      'of',
      'and',
      'at',
      'in',
      'for',

      'campus',

      'institute',
      'institution',

      'engineering',
      'technology',

      'indian',
      'national',

      'university',
      'college',
    ]);


  return normalize(
    value
  )
    .split(
      ' '
    )

    .filter(
      Boolean
    )

    .filter(
      token =>
        (
          token.length > 1 &&
          !STOP.has(
            token
          )
        )
    );
}


/*
|--------------------------------------------------------------------------
| FAMILY
|--------------------------------------------------------------------------
*/

function instituteFamily(
  value
) {
  const tokens =
    normalize(
      value
    )
      .split(
        ' '
      )
      .filter(
        Boolean
      );


  const compacted =
    compact(
      value
    );


  /*
  | IIIT must be checked before NIT.
  */

  if (
    tokens.includes(
      'iiit'
    ) ||
    compacted.startsWith(
      'iiit'
    )
  ) {
    return 'IIIT';
  }


  if (
    tokens.includes(
      'nit'
    ) ||
    compacted.startsWith(
      'nit'
    )
  ) {
    return 'NIT';
  }


  return null;
}


/*
|--------------------------------------------------------------------------
| SAME FAMILY
|--------------------------------------------------------------------------
*/

function sameInstituteFamily(
  left,
  right
) {
  const leftFamily =
    instituteFamily(
      left
    );


  const rightFamily =
    instituteFamily(
      right
    );


  if (
    !leftFamily ||
    !rightFamily
  ) {
    return false;
  }


  return (
    leftFamily ===
    rightFamily
  );
}


/*
|--------------------------------------------------------------------------
| TOKEN SIMILARITY
|--------------------------------------------------------------------------
*/

function tokenSimilarity(
  left,
  right
) {
  const a =
    new Set(
      institutionTokens(
        left
      )
    );


  const b =
    new Set(
      institutionTokens(
        right
      )
    );


  if (
    a.size === 0 ||
    b.size === 0
  ) {
    return 0;
  }


  let common =
    0;


  for (
    const token of a
  ) {
    if (
      b.has(
        token
      )
    ) {
      common += 1;
    }
  }


  /*
  |--------------------------------------------------------------------------
  | Short aliases should match long official names.
  |
  | Example:
  | NIT Rourkela
  | National Institute of Technology Rourkela
  |--------------------------------------------------------------------------
  */

  return (
    common /
    Math.min(
      a.size,
      b.size
    )
  );
}


/*
|--------------------------------------------------------------------------
| STRONG IDENTITY TOKEN
|--------------------------------------------------------------------------
*/

function containsStrongIdentityToken(
  left,
  right
) {
  const FAMILY_TOKENS =
    new Set([
      'nit',
      'iiit',
    ]);


  const leftTokens =
    institutionTokens(
      left
    )
      .filter(
        token =>
          !FAMILY_TOKENS
            .has(
              token
            )
      );


  const rightTokens =
    new Set(
      institutionTokens(
        right
      )
        .filter(
          token =>
            !FAMILY_TOKENS
              .has(
                token
              )
        )
    );


  if (
    leftTokens.length === 0 ||
    rightTokens.size === 0
  ) {
    return false;
  }


  return leftTokens.some(
    token =>
      rightTokens.has(
        token
      )
  );
}


/*
|--------------------------------------------------------------------------
| MATCH EXTERNAL REVIEW INTELLIGENCE
|--------------------------------------------------------------------------
*/

export function getExternalReviewIntelligence({
  collegeName,
}) {
  loadExternalReviewJson();


  if (
    !collegeName
  ) {
    return null;
  }


  /*
  |--------------------------------------------------------------------------
  | 1. EXACT / ALIAS MATCH
  |--------------------------------------------------------------------------
  */

  const exactKey =
    compact(
      collegeName
    );


  const exact =
    intelligenceByInstitution
      .get(
        exactKey
      );


  if (
    exact
  ) {
    return exact;
  }


  /*
  |--------------------------------------------------------------------------
  | UNIQUE PROFILES
  |--------------------------------------------------------------------------
  */

  const profiles =
    [
      ...new Set(
        intelligenceByInstitution
          .values()
      ),
    ];


  const target =
    normalize(
      collegeName
    );


  /*
  |--------------------------------------------------------------------------
  | 2. NORMALIZED EXACT MATCH
  |--------------------------------------------------------------------------
  */

  for (
    const profile of profiles
  ) {
    if (
      normalize(
        profile.institution
      ) ===
      target
    ) {
      return profile;
    }
  }


  /*
  |--------------------------------------------------------------------------
  | 3. NIT / IIIT SMART MATCH
  |--------------------------------------------------------------------------
  */

  let bestProfile =
    null;


  let bestScore =
    0;


  for (
    const profile of profiles
  ) {

    /*
    | Never cross-match NIT and IIIT.
    */

    if (
      !sameInstituteFamily(
        collegeName,
        profile.institution
      )
    ) {
      continue;
    }


    /*
    | Require meaningful identity overlap:
    | Rourkela, Surathkal, Vadodara, Diu, Allahabad, etc.
    */

    if (
      !containsStrongIdentityToken(
        collegeName,
        profile.institution
      )
    ) {
      continue;
    }


    const score =
      tokenSimilarity(
        collegeName,
        profile.institution
      );


    if (
      score >
      bestScore
    ) {
      bestScore =
        score;


      bestProfile =
        profile;
    }
  }


  /*
  |--------------------------------------------------------------------------
  | Conservative acceptance
  |--------------------------------------------------------------------------
  */

  if (
    bestProfile &&
    bestScore >= 0.72
  ) {
    return bestProfile;
  }


  return null;
}


/*
|--------------------------------------------------------------------------
| DEBUG STATS
|--------------------------------------------------------------------------
*/

export function getExternalReviewStats() {
  loadExternalReviewJson();


  const profiles =
    new Set(
      intelligenceByInstitution
        .values()
    );


  return {
    aliases:
      intelligenceByInstitution
        .size,


    institutions:
      profiles.size,


    nit:
      [
        ...profiles,
      ]
        .filter(
          profile =>
            instituteFamily(
              profile.institution
            ) ===
            'NIT'
        )
        .length,


    iiit:
      [
        ...profiles,
      ]
        .filter(
          profile =>
            instituteFamily(
              profile.institution
            ) ===
            'IIIT'
        )
        .length,
  };
}


/*
|--------------------------------------------------------------------------
| DEBUG INSTITUTION LIST
|--------------------------------------------------------------------------
*/

export function getExternalReviewInstitutions() {
  loadExternalReviewJson();


  return [
    ...new Set(
      intelligenceByInstitution
        .values()
    ),
  ]
    .map(
      profile => ({
        institution:
          profile.institution,

        family:
          instituteFamily(
            profile.institution
          ),

        evidence:
          profile
            ?.evidence
            ?.usableEvidence ??
          0,

        sources:
          profile
            ?.evidence
            ?.sourceCount ??
          0,
      })
    )

    .sort(
      (
        a,
        b
      ) =>
        String(
          a.institution
        )
          .localeCompare(
            String(
              b.institution
            )
          )
    );
}