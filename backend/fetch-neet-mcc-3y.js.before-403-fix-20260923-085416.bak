import fs from 'fs';
import path from 'path';
import crypto from 'crypto';

const ROOT =
  path.resolve(
    './data/neet/mcc'
  );

const SOURCES = [
  {
    year: 2026,
    url: 'https://mcc.nic.in/current-events-ug/',
  },
  {
    year: 2025,
    url: 'https://mcc.nic.in/archive-ug/',
  },
  {
    year: 2024,
    url: 'https://mcc.nic.in/archive-ug/',
  },
];


function ensureDir(
  dir
) {
  fs.mkdirSync(
    dir,
    {
      recursive: true,
    }
  );
}


function decodeHtml(
  text
) {
  return String(
    text || ''
  )
    .replace(
      /&amp;/g,
      '&'
    )
    .replace(
      /&quot;/g,
      '"'
    )
    .replace(
      /&#39;/g,
      "'"
    )
    .replace(
      /&nbsp;/g,
      ' '
    )
    .replace(
      /&ndash;/g,
      '-'
    )
    .replace(
      /&mdash;/g,
      '-'
    )
    .replace(
      /<[^>]+>/g,
      ' '
    )
    .replace(
      /\s+/g,
      ' '
    )
    .trim();
}


function absoluteUrl(
  value,
  base
) {
  try {
    return new URL(
      value,
      base
    ).href;
  }
  catch {
    return null;
  }
}


function slugify(
  value
) {
  return String(
    value || ''
  )
    .toLowerCase()
    .replace(
      /[^a-z0-9]+/g,
      '-'
    )
    .replace(
      /^-+|-+$/g,
      ''
    )
    .slice(
      0,
      140
    );
}


function classifyRound(
  title
) {
  const value =
    String(
      title || ''
    ).toLowerCase();


  if (
    /special\s+stray/.test(
      value
    )
  ) {
    if (
      /\biii\b|round\s*3/.test(
        value
      )
    ) {
      return 'special-stray-3';
    }

    if (
      /\bii\b|round\s*2/.test(
        value
      )
    ) {
      return 'special-stray-2';
    }

    return 'special-stray';
  }


  if (
    /stray/.test(
      value
    )
  ) {
    return 'stray';
  }


  if (
    /round[\s-]*(1|i)\b/.test(
      value
    )
  ) {
    return 'round-1';
  }


  if (
    /round[\s-]*(2|ii)\b/.test(
      value
    )
  ) {
    return 'round-2';
  }


  if (
    /round[\s-]*(3|iii)\b/.test(
      value
    )
  ) {
    return 'round-3';
  }


  if (
    /round[\s-]*4\b/.test(
      value
    )
  ) {
    return 'round-4';
  }


  if (
    /round[\s-]*5\b/.test(
      value
    )
  ) {
    return 'round-5';
  }


  if (
    /round[\s-]*6\b/.test(
      value
    )
  ) {
    return 'round-6';
  }


  return 'other';
}


function looksLikeFinalResult(
  title,
  year
) {
  const value =
    String(
      title || ''
    ).toLowerCase();


  if (
    !value.includes(
      String(year)
    )
  ) {
    return false;
  }


  if (
    !(
      value.includes(
        'final result'
      ) ||
      value.includes(
        'final allotment result'
      )
    )
  ) {
    return false;
  }


  if (
    value.includes(
      'notice'
    )
  ) {
    return false;
  }


  if (
    !(
      value.includes(
        'ug'
      ) ||
      value.includes(
        'neet'
      )
    )
  ) {
    return false;
  }


  return true;
}


function extractAnchors(
  html,
  baseUrl
) {
  const anchors = [];

  const regex =
    /<a\b[^>]*href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;

  let match;

  while (
    (
      match =
        regex.exec(
          html
        )
    )
  ) {
    const href =
      absoluteUrl(
        match[1],
        baseUrl
      );

    const text =
      decodeHtml(
        match[2]
      );

    if (
      href &&
      text
    ) {
      anchors.push({
        href,
        text,
      });
    }
  }

  return anchors;
}


async function fetchText(
  url
) {
  const response =
    await fetch(
      url,
      {
        headers: {
          'user-agent':
            'Mozilla/5.0 TruMarg-DataFetcher/1.0',
          accept:
            'text/html,application/xhtml+xml',
        },
      }
    );


  if (
    !response.ok
  ) {
    throw new Error(
      `HTTP ${response.status} for ${url}`
    );
  }


  return await response.text();
}


async function resolvePdfFromDocumentPage(
  url
) {
  if (
    /\.pdf(?:$|\?)/i.test(
      url
    )
  ) {
    return url;
  }


  const html =
    await fetchText(
      url
    );


  const anchors =
    extractAnchors(
      html,
      url
    );


  const pdf =
    anchors.find(
      item =>
        /\.pdf(?:$|\?)/i.test(
          item.href
        )
    );


  return (
    pdf?.href ||
    null
  );
}


async function downloadFile(
  url,
  outputPath
) {
  const response =
    await fetch(
      url,
      {
        headers: {
          'user-agent':
            'Mozilla/5.0 TruMarg-DataFetcher/1.0',
          accept:
            'application/pdf,*/*',
        },
      }
    );


  if (
    !response.ok
  ) {
    throw new Error(
      `HTTP ${response.status} for ${url}`
    );
  }


  const buffer =
    Buffer.from(
      await response.arrayBuffer()
    );


  fs.writeFileSync(
    outputPath,
    buffer
  );


  return {
    bytes:
      buffer.length,

    sha256:
      crypto
        .createHash(
          'sha256'
        )
        .update(
          buffer
        )
        .digest(
          'hex'
        ),
  };
}


async function discoverYear(
  year,
  pageUrl
) {
  console.log(
    `\n===== DISCOVER ${year} =====`
  );


  const html =
    await fetchText(
      pageUrl
    );


  const anchors =
    extractAnchors(
      html,
      pageUrl
    );


  const candidates = [];

  for (
    const anchor of anchors
  ) {
    if (
      !looksLikeFinalResult(
        anchor.text,
        year
      )
    ) {
      continue;
    }


    candidates.push({
      year,
      title:
        anchor.text,
      pageUrl:
        anchor.href,
      round:
        classifyRound(
          anchor.text
        ),
    });
  }


  /*
   * Deduplicate same document links/titles.
   */

  const unique =
    [
      ...new Map(
        candidates.map(
          item => [
            `${item.title}::${item.pageUrl}`,
            item,
          ]
        )
      ).values(),
    ];


  console.log(
    `Found ${unique.length} candidate final-result documents`
  );


  return unique;
}


async function run() {
  ensureDir(
    ROOT
  );


  const masterManifest = {
    fetchedAt:
      new Date()
        .toISOString(),

    source:
      'Medical Counselling Committee (MCC)',

    exam:
      'NEET UG',

    scope:
      'MCC UG counselling result documents',

    years: {},
  };


  for (
    const source of SOURCES
  ) {
    const {
      year,
      url,
    } =
      source;


    const yearDir =
      path.join(
        ROOT,
        String(year)
      );


    const rawDir =
      path.join(
        yearDir,
        'raw'
      );


    ensureDir(
      rawDir
    );


    const discovered =
      await discoverYear(
        year,
        url
      );


    const results = [];


    for (
      const item of discovered
    ) {
      console.log(
        `\n[${year}] ${item.title}`
      );


      try {
        const pdfUrl =
          await resolvePdfFromDocumentPage(
            item.pageUrl
          );


        if (
          !pdfUrl
        ) {
          console.log(
            '  PDF not found'
          );

          results.push({
            ...item,
            pdfUrl:
              null,
            status:
              'pdf-not-found',
          });

          continue;
        }


        const filename =
          `${
            item.round
          }-${
            slugify(
              item.title
            )
          }.pdf`;


        const outputPath =
          path.join(
            rawDir,
            filename
          );


        const meta =
          await downloadFile(
            pdfUrl,
            outputPath
          );


        console.log(
          `  saved: ${outputPath}`
        );

        console.log(
          `  size: ${meta.bytes} bytes`
        );


        results.push({
          ...item,

          pdfUrl,

          filename,

          bytes:
            meta.bytes,

          sha256:
            meta.sha256,

          status:
            'downloaded',
        });

      }
      catch (
        error
      ) {
        console.error(
          `  ERROR: ${error.message}`
        );


        results.push({
          ...item,

          status:
            'error',

          error:
            error.message,
        });
      }
    }


    const yearManifest = {
      year,

      sourcePage:
        url,

      fetchedAt:
        new Date()
          .toISOString(),

      documents:
        results,
    };


    fs.writeFileSync(
      path.join(
        yearDir,
        'manifest.json'
      ),
      JSON.stringify(
        yearManifest,
        null,
        2
      ),
      'utf8'
    );


    masterManifest
      .years[
        year
      ] =
      yearManifest;
  }


  fs.writeFileSync(
    path.join(
      ROOT,
      'manifest.json'
    ),
    JSON.stringify(
      masterManifest,
      null,
      2
    ),
    'utf8'
  );


  console.log(
    '\n========================================'
  );

  console.log(
    'NEET MCC 3-year raw fetch complete'
  );

  console.log(
    `Root: ${ROOT}`
  );

  console.log(
    '========================================'
  );
}


run().catch(
  error => {
    console.error(
      '\nFETCH FAILED'
    );

    console.error(
      error
    );

    process.exit(
      1
    );
  }
);
